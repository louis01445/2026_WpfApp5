<Window x:Class="_2026_WpfApp5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2026_WpfApp5"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="350"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal">
            <Label Content="學生" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <ComboBox x:Name="studentComboBox" HorizontalAlignment="Left" VerticalAlignment="Center" Width="120"/>
        </StackPanel>
        <StatusBar Grid.Row="2" Grid.ColumnSpan="3">
            <TextBlock Width="300" VerticalAlignment="Center"/>
        </StatusBar>
        <TabControl Grid.Row="1">
            <TabItem Header="以教師分類課程">
                <TreeView x:Name="teacherTreeView" Background="#FFFF86F5"/>
            </TabItem>
            <TabItem Header="所有課程">
                <ListBox x:Name="teacherListBox" Background="#FF00E2FF"/>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical">
            <Button x:Name="addCourseButton" Content="選課" Width="60" Height="30" Margin="0,10,0,10"/>
            <Button x:Name="addCourseButton1" Content="退選" Width="60" Height="30" Margin="0,10,0,10"/>
            <Button x:Name="addCourseButton2" Content="存檔" Width="60" Height="30" Margin="0,10,0,10"/>
        </StackPanel>
        <ListView Grid.Row="1" Grid.Column="2" Background="#FFFF29ED">
        </ListView>
    </Grid>
</Window>
